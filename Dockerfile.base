FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /src

# Install dotnet-ef tool and setup env path
RUN dotnet tool install --global dotnet-ef --version 9.0.0
ENV PATH="$PATH:/root/.dotnet/tools"

# Copy solution file
COPY ["InnovateFuture.sln", "../"]

# Copy main project files
COPY ["src/InnovateFuture.Api/*.csproj", "InnovateFuture.Api/"]
COPY ["src/InnovateFuture.Application/*.csproj", "InnovateFuture.Application/"]
COPY ["src/InnovateFuture.Domain/*.csproj", "InnovateFuture.Domain/"]
COPY ["src/InnovateFuture.Infrastructure/*.csproj", "InnovateFuture.Infrastructure/"]

# Copy test project files (only existing ones)
COPY ["tests/InnovateFuture.Api.Tests/*.csproj", "InnovateFuture.Api.Tests/"]
COPY ["tests/InnovateFuture.Application.Tests/*.csproj", "InnovateFuture.Application.Tests/"]
COPY ["tests/InnovateFuture.Domain.Tests/*.csproj", "InnovateFuture.Domain.Tests/"]

# Restore packages
RUN dotnet restore "InnovateFuture.Api/InnovateFuture.Api.csproj"
RUN dotnet restore "InnovateFuture.Api.Tests/InnovateFuture.Api.Tests.csproj"

# Copy all source code
COPY src/ .
COPY tests/ .

# Build the projects
RUN dotnet build "InnovateFuture.Api/InnovateFuture.Api.csproj" -c Release
RUN dotnet build "InnovateFuture.Api.Tests/InnovateFuture.Api.Tests.csproj" -c Release

# Set the entry point to allow for different commands
ENTRYPOINT ["dotnet"]
