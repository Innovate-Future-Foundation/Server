pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '986643365562'
        AWS_REGION = 'ap-southeast-2'
        ECS_CLUSTER = 'arn:aws:ecs:ap-southeast-2:986643365562:cluster/DevCluster'
        ECS_SERVICE = 'api-service'
        TASK_DEFINITION = 'api-task'
        ECR_REPO = '986643365562.dkr.ecr.ap-southeast-2.amazonaws.com/ecr-repo'
        IMAGE_TAG = params.IMAGE_TAG
    }

    stages {
        stage('Update ECS Task Definition') {
            steps {
                script {
                    sh '''
                        # Get current task definition
                        TASK_DEF=$(aws ecs describe-task-definition --task-definition ${TASK_DEFINITION})
                        
                        # Update image in task definition
                        NEW_TASK_DEF=$(echo $TASK_DEF | jq --arg IMAGE "${ECR_REPO}:${IMAGE_TAG}" \
                            '.taskDefinition | .containerDefinitions[0].image = $IMAGE')
                        
                        # Register new task definition
                        aws ecs register-task-definition --family ${TASK_DEFINITION} \
                            --cli-input-json "$NEW_TASK_DEF"
                    '''
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh '''
                        aws ecs update-service --cluster ${ECS_CLUSTER} \
                            --service ${ECS_SERVICE} \
                            --task-definition ${TASK_DEFINITION} \
                            --force-new-deployment
                    '''
                }
            }
        }

        stage('Monitor Deployment') {
            steps {
                script {
                    sh '''
                        aws ecs wait services-stable \
                            --cluster ${ECS_CLUSTER} \
                            --services ${ECS_SERVICE}
                    '''
                }
            }
        }
    }
}
