pipeline {
    agent any
    
    environment {
        ECR_URL = '986643365562.dkr.ecr.ap-southeast-2.amazonaws.com/inff-2'
        AWS_REGION = 'ap-southeast-2'
        DB_HOST = 'postgres'
        DB_PORT = '5432'
        DB_NAME = 'InnovateFuture'
        DB_USER = 'db_admin'
        DB_PASS = '123321abb'
        PG_USER = 'db@inff.com'
        PG_PASS = 'q4hbGe7N3EAy'
        JWT_SECRET = 'u68-03Pn4n_@w@fM'
        DEP_ENV = 'Development'
    }
    
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URL}
                    '''
                }
            }
        }

        stage('Build Base Image') {
            steps {
                script {
                    sh '''
                        docker build -f Dockerfile.base -t inff-api-build .
                    '''
                }
            }
        }

        stage('Build and Test') {
            steps {
                script {
                    sh '''
                echo "DB_HOST=${DB_HOST}" > .env
                echo "DB_PORT=${DB_PORT}" >> .env
                echo "DB_NAME=${DB_NAME}" >> .env
                echo "DB_USER=${DB_USER}" >> .env
                echo "DB_PASS=${DB_PASS}" >> .env
                echo "PG_USER=${PG_USER}" >> .env
                echo "PG_PASS=${PG_PASS}" >> .env
                echo "JWT_SECRET=${JWT_SECRET}" >> .env
                echo "DEP_ENV=${DEP_ENV}" >> .env
                
                # Build base image first
                docker build -f Dockerfile.base -t inff-api-build .
                
                # Run tests with proper database initialization
                docker-compose -f docker-compose.test.yml up --build --exit-code-from tests
                
                # Build final API image if tests pass
                docker build -f Dockerfile.api -t ${ECR_URL}:${BUILD_NUMBER} .
                docker tag ${ECR_URL}:${BUILD_NUMBER} ${ECR_URL}:latest
            '''
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    sh '''
                        docker push ${ECR_URL}:${BUILD_NUMBER}
                        docker push ${ECR_URL}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker-compose -f docker-compose.test.yml down -v
                docker logout ${ECR_URL}
                rm -f .env
                docker rmi inff-api-build || true
                docker rmi ${ECR_URL}:${BUILD_NUMBER} || true
                docker rmi ${ECR_URL}:latest || true
            '''
            cleanWs()
        }
    }
}
