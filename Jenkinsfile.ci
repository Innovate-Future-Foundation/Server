pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '986643365562'
        AWS_REGION = 'ap-southeast-2'
        ECR_REPO = '986643365562.dkr.ecr.ap-southeast-2.amazonaws.com/ecr-repo'
        IMAGE_TAG = "${env.GIT_COMMIT}-${env.BUILD_NUMBER}"
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    sh '''
                        docker compose build --parallel base api
                    '''
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    credentialsId: 'aws-credentials', region: env.AWS_REGION
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPO}
                        docker tag api:latest ${ECR_REPO}:${IMAGE_TAG}
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
            sh 'docker system prune -f'
        }
    }
}
