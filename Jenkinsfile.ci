pipeline {
    agent any
    
    environment {
        AWS_CREDENTIALS = 'aws-credentials'
        ECR_URL = '986643365562.dkr.ecr.ap-southeast-2.amazonaws.com/ecr-repo'
        AWS_REGION = 'ap-southeast-2'
    }
    
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([[
                    credentialsId: "${AWS_CREDENTIALS}",
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY',
                    class: 'AmazonWebServicesCredentialsBinding'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URL}
                    '''
                }
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    docker build -t ${ECR_URL}:${BUILD_NUMBER} .
                    docker tag ${ECR_URL}:${BUILD_NUMBER} ${ECR_URL}:latest
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    credentialsId: "${AWS_CREDENTIALS}",
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY',
                    class: 'AmazonWebServicesCredentialsBinding'
                ]]) {
                    sh '''
                        docker push ${ECR_URL}:${BUILD_NUMBER}
                        docker push ${ECR_URL}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout ${ECR_URL}'
            cleanWs()
        }
    }
}
