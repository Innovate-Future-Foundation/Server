pipeline {
    agent any
    
    environment {
        ECR_URL = '986643365562.dkr.ecr.ap-southeast-2.amazonaws.com/ecr-repo'
        AWS_REGION = 'ap-southeast-2'
    }
    
    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('ECR Login') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_URL}
                    '''
                }
            }
        }

        stage('Build and Test') {
            steps {
                script {
                    sh '''
                        docker build \
                            --build-arg DB_HOST=postgres \
                            --build-arg DB_PORT=5432 \
                            --build-arg DB_NAME=InnovateFuture \
                            --build-arg DB_USER=db_admin \
                            --build-arg DB_PASS=123321abb \
                            --build-arg PG_USER=db@inff.com \
                            --build-arg PG_PASS=q4hbGe7N3EAy \
                            --build-arg JWT_SECRET=u68-03Pn4n_@w@fM \
                            --build-arg DEP_ENV=Development \
                            -t ${ECR_URL}:${BUILD_NUMBER} .
                        docker tag ${ECR_URL}:${BUILD_NUMBER} ${ECR_URL}:latest
                    '''
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-credentials',
                        accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                        secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                    ]
                ]) {
                    sh '''
                        docker push ${ECR_URL}:${BUILD_NUMBER}
                        docker push ${ECR_URL}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout ${ECR_URL}'
            cleanWs()
        }
    }
}
