<!DOCTYPE html>
<html lang="en">
<head>
    <title>Welcome!</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .outer-table {
            width: 100%;
            background-color: #f5f5f5;
            padding: 20px 0;
        }
        .container {
            background-color: #ffffff;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .verify-btn {
            display: inline-block;
            width: 200px;
            height: 50px;
            background-color: #2269f0;
            color: white !important;
            font-weight: bold;
            text-decoration: none;
            line-height: 50px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }
        .verify-btn:hover {
            background-color: #1a51c3;
        }
        table {
            width: 100%;
            margin-top: 30px;
        }
        .inner-table {
            padding: 25px;
            max-width: 800px;
            margin: 0 auto;
            text-align: left;
        }
        td {
            vertical-align: middle;
        }
        img {
            max-width: 100px;
            height: auto;
        }
        .contact-info {
            padding-left: 20px;
        }
    </style>
</head>
<body>
<table class="outer-table">
    <tr>
        <td>
            <div class="container">
                <h1>Hello, {{userName}}!</h1>
                <h3>Reset your password, Please click the link below to verify your email:</h3>
                <a class="verify-btn" href="{{verificationLink}}">Verify My Email</a>
                <p>If you have any issues with setting up your account, please contact the information below for assistance:</p>
                <table class="inner-table">
                    <tr style="margin-top: 20px">
                        <td class="contact-info">
                            <h4>Innovate Feature</h4>
                            <p>Website: <a href="https://www.innovatefeature.com.au">www.innovatefeature.com.au</a></p>
                            <p>Email: <a href="mailto:innovateFeature@gmail.com">innovatefeature@gmail.com</a></p>
                        </td>
                        <td style="text-align: left">
                            <img src="https://www.innovatefuture.foundation/images/logo.png" alt="innovate Feature Logo"/>
                        </td>
                    </tr>
                </table>
            </div>
        </td>
    </tr>
</table>
</body>
</html>
